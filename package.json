{
  "name": "wesc",
  "version": "0.6.0",
  "description": "We are the Superlative Components!",
  "type": "module",
  "main": "index.cjs",
  "types": "index.d.ts",
  "bin": {
    "wesc": "bin/cli.js"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "bin",
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./dom/unshim": "./dist/dom/unshim.js",
    "./dom/server": "./dist/dom/server.js",
    "./dom/react": "./dist/dom/react/index.js",
    "./dom/astro": "./src/dom/astro/index.js",
    "./dom/astro/*": "./src/dom/astro/*"
  },
  "napi": {
    "name": "wesc",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "repository": "luwes/wesc",
  "author": "Wesley Luyten <me@wesleyluyten.com> (https://wesleyluyten.com)",
  "license": "MIT",
  "homepage": "https://github.com/luwes/wesc#readme",
  "bugs": {
    "url": "https://github.com/luwes/wesc/issues"
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "lint": "npx eslint@8 src/*.js src/**/*.js -c ./node_modules/wet-run/.eslintrc.json",
    "test": "pta 'test/**/*.spec.js' --reporter tap",
    "dev": "wet serve --cors --redirect :examples/ & esbuild src/dom/server.js src/dom/unshim.js src/dom/react/index.js src/dom/react/render.js --format=esm --external:react --external:react-dom --external:./server.js --external:./render.js --outdir=dist/dom --bundle --watch",
    "build:js": "esbuild src/dom/server.js src/dom/unshim.js src/dom/react/index.js src/dom/react/render.js --format=esm --external:react --external:react-dom --external:./server.js --external:./render.js --outdir=dist/dom --bundle --minify --tree-shaking=true",
    "build:native": "napi build --platform --release --cargo-cwd crates/wesc-node --js index.cjs --dts index.d.ts",
    "build:native:debug": "napi build --platform --cargo-cwd crates/wesc-node --js index.cjs --dts index.d.ts",
    "build": "npm run build:js",
    "artifacts": "napi artifacts",
    "prepublishOnly": "npm run build:js && napi prepublish -t npm --skip-gh-release ${NAPI_PREPUBLISH_FLAGS:-}"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "esbuild": "^0.20.0",
    "prettier": "^3.2.4",
    "pta": "^1.2.0",
    "wet-run": "^1.0.3",
    "zora": "^5.2.0"
  },
  "dependencies": {
    "linkedom": "github:luwes/linkedom#wesc"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18",
    "react-dom": "^17.0.2 || ^18"
  }
}
