<template>
  <span class="cell flight"><slot name="flight"></slot></span>
  <span class="cell route"><slot name="route"></slot></span>
  <span class="cell time"><slot name="time"></slot></span>
  <span class="cell gate"><slot name="gate"></slot></span>
  <span class="cell status"><slot name="status"></slot></span>
  <button class="details-toggle" type="button" aria-expanded="false">Details</button>
  <span class="details" hidden>
    <span class="details-label">Details</span>
    <slot name="details"></slot>
  </span>
</template>

<style>
  flight-row {
    display: grid;
    grid-template-columns: 90px 1fr 110px 70px 130px 72px;
    gap: 24px;
    align-items: baseline;
    padding: 10px 28px;
    border-bottom: 1px solid #141414;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    cursor: pointer;
  }

  flight-row:hover,
  flight-row:focus-visible {
    background: #101010;
  }

  flight-row:nth-child(even) {
    background: #0a0a0a;
  }

  flight-row:nth-child(even):hover,
  flight-row:nth-child(even):focus-visible {
    background: #111;
  }

  flight-row[expanded] {
    background: #101010;
  }

  flight-row .flight {
    font-weight: 600;
    color: #f3f3f3;
    letter-spacing: 0.02em;
  }

  flight-row .route {
    color: #d0d0d0;
  }

  flight-row .time {
    color: #aaa;
  }

  flight-row.is-delayed .time {
    color: #ffae5c;
    text-decoration: line-through;
  }

  flight-row.is-delayed .time::after {
    content: " " attr(data-eta);
    color: #fff;
    text-decoration: none;
    margin-left: 6px;
  }

  flight-row .gate {
    color: #888;
    font-variant-numeric: tabular-nums;
  }

  flight-row .details-toggle {
    width: 72px;
    border: 1px solid #292929;
    border-radius: 4px;
    background: #111;
    color: #aaa;
    font: inherit;
    font-size: 11px;
    text-transform: uppercase;
    cursor: pointer;
  }

  flight-row .details-toggle:hover,
  flight-row .details-toggle:focus-visible {
    border-color: #555;
    color: #f3f3f3;
  }

  flight-row[expanded] .details-toggle {
    border-color: #ff8a4c;
    color: #ffae5c;
  }

  flight-row .details {
    grid-column: 2 / -1;
    color: #777;
    font-size: 12px;
    padding-top: 2px;
  }

  flight-row .details-label {
    color: #ff8a4c;
    font-size: 11px;
    letter-spacing: 0.12em;
    margin-right: 10px;
    text-transform: uppercase;
  }
</style>

<script>
  customElements.define('flight-row', class extends HTMLElement {
    connectedCallback() {
      if (this.hasAttribute('data-enhanced')) return;

      this.setAttribute('data-enhanced', '');
      this.tabIndex = 0;
      this.setAttribute('role', 'button');
      this.setAttribute('aria-expanded', 'false');

      this.querySelector('.details-toggle')?.addEventListener('click', (event) => {
        event.stopPropagation();
        this.toggleDetails();
      });

      this.addEventListener('click', () => this.toggleDetails());
      this.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        this.toggleDetails();
      });
    }

    toggleDetails() {
      const expanded = !this.hasAttribute('expanded');
      this.toggleAttribute('expanded', expanded);
      this.setAttribute('aria-expanded', String(expanded));
      this.querySelector('.details')?.toggleAttribute('hidden', !expanded);
      this.querySelector('.details-toggle')?.setAttribute('aria-expanded', String(expanded));
    }
  });
</script>
