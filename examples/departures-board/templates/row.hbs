<link rel="definition" name="flight-row" href="./components/flight-row.hbs">
<link rel="definition" name="status-badge" href="./components/status-badge.hbs">

<template>
  <flight-row class="{{#if delayed}}is-delayed{{/if}}" data-eta="{{eta}}">
    <span slot="flight">{{flight}}</span>
    <span slot="route">{{route}}</span>
    <span slot="time">{{time}}</span>
    <span slot="gate">{{gate}}</span>
    <status-badge slot="status" status="{{statusKey}}">{{statusLabel}}</status-badge>
    <span slot="details">{{terminal}} · {{aircraft}} · {{connection}}</span>
  </flight-row>
</template>
