<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Departures · WeSC</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
      :root { color-scheme: dark; }
      html, body { margin: 0; background: #050505; color: #ddd; font: 14px/1.4 -apple-system, system-ui, "SF Mono", ui-monospace, monospace; }
      header { position: sticky; top: 0; z-index: 1; background: #050505; padding: 18px 28px 14px; border-bottom: 1px solid #1a1a1a; }
      header h1 { margin: 0 0 4px; font-size: 13px; letter-spacing: 0.4em; color: #ff8a4c; font-weight: 600; text-transform: uppercase; }
      header p { margin: 0; font-size: 12px; color: #777; }
      .head-row { display: grid; grid-template-columns: 90px 1fr 110px 70px 130px 72px; gap: 24px; padding: 10px 28px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: #555; border-bottom: 1px solid #1a1a1a; }
    </style>
  </head>
  <body>
    <header>
      <h1>Departures</h1>
      <p>{{rowCount}} flights · Wesc-stamped rows, rendered by Handlebars</p>
    </header>
    <div class="head-row">
      <span>Flight</span><span>Destination</span><span>Time</span><span>Gate</span><span>Status</span><span>Info</span>
    </div>
